# Serverdə /opt/arzoom/.env faylına köçür və dəyərləri dəyiş.
POSTGRES_PASSWORD=uzun-ve-tesadufi-parol
ADMIN_TOKEN=uzun-ve-tesadufi-token
# SMS provayderi qoşulana qədər true: kod ekranda göstərilir.
DEMO_SMS=true
# Domen (məs. lizinq.arzoom.az) və ya serverin IP ünvanı. Domen olanda Let's Encrypt sertifikatı avtomatik alınır.
SITE_ADDRESS=lizinq.arzoom.az
