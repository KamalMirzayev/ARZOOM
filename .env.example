# Serverdə /opt/arzoom/.env faylına köçür və dəyərləri dəyiş (bootstrap.sh bunu avtomatik yaradır).
POSTGRES_PASSWORD=uzun-ve-tesadufi-parol
# Əməkdaş panelinə giriş açarı, ən azı 12 simvol: openssl rand -hex 24
ADMIN_TOKEN=uzun-ve-tesadufi-token

# Domen (məs. lizinq.arzoom.az). Domenin A qeydi serverin IP-sinə baxmalıdır; sertifikat avtomatik alınır.
SITE_ADDRESS=lizinq.arzoom.az

# Korporativ saytın domenləri (site/ konteyneri). www ünvanı əsas domenə yönləndirilir.
# Lizinq tətbiqi bu halda SITE_ADDRESS=lizinq.arzoomavto.az olur.
# Domen yoxdursa, deploy.sh bunu avtomatik https://SITE_ADDRESS:8443 edir.
# WEBSITE_ADDRESS=arzoomavto.az www.arzoomavto.az

# Əməkdaş panelini yalnız ofis IP-lərindən açmaq üçün (boşluqla ayır). Boş qalsa, hər yerdən açılır.
# ADMIN_ALLOW=85.132.0.10/32 94.20.0.0/24

# SMS: Softline (gw.soft-line.az). İstifadəçi adı və API açarı yazılan kimi demo rejimi söndürülür, kodlar real SMS ilə gedir.
# Yoxlama: docker compose exec app node sms-test.js 994XXXXXXXXX
# SOFTLINE_USER=
# SOFTLINE_KEY=
# SOFTLINE_SENDER=Arzoomavto

# Başqa SMS provayderi. SMS_URL yazılan kimi demo rejimi söndürülür və kodlar real SMS ilə gedir.
# {phone} 994XXXXXXXXX formatında nömrə, {text} mesaj mətnidir.
# SMS_URL=https://sms.provider.az/send?login=LOGIN&key=KEY&msisdn={phone}&text={text}
# SMS_METHOD=POST
# SMS_BODY={"to":"{phone}","message":"{text}"}
# SMS_HEADERS={"Authorization":"Bearer TOKEN","Content-Type":"application/json"}
DEMO_SMS=true
# SMS qoşulana qədər bütün kodlar bu olur
DEMO_OTP=123456
