# HTTPS: with a domain Caddy gets and renews a Let's Encrypt certificate itself and redirects HTTP to HTTPS.
# With only an IP address it uses its own certificate, so browsers show a warning until a domain is set.
{
	# Browsers send no SNI when the address is a bare IP; without this the TLS handshake fails.
	default_sni {$SITE_ADDRESS:localhost}
	servers {
		protocols h1 h2 h3
	}
}

(secure) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	log {
		output stdout
		format console
	}
}

# Lizinq tətbiqi (müraciət, kabinet, əməkdaş paneli), məs. lizinq.arzoomavto.az
{$SITE_ADDRESS:localhost} {
	import secure

	# Staff panel and its API can be limited to office IPs via ADMIN_ALLOW in .env.
	@staff_blocked {
		path /admin /admin/* /admin.html /api/admin/*
		not remote_ip {$ADMIN_ALLOW:0.0.0.0/0 ::/0}
	}
	respond @staff_blocked 403

	@staff path /admin /admin/* /admin.html /api/admin/*
	header @staff X-Robots-Tag "noindex, nofollow"

	request_body {
		max_size 220MB
	}

	reverse_proxy app:3000
}

# Korporativ sayt (site/ konteyneri), məs. "arzoomavto.az www.arzoomavto.az". www ünvanı əsas domenə yönləndirilir.
{$WEBSITE_ADDRESS:website.localhost} {
	import secure

	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} 308

	reverse_proxy website:8080
}

# Robocall (AI zəng sistemi, /opt/robocall): Docker-də deyil, hostda systemd ilə işləyir.
# Ünvan .env-dəki AICALL_ADDRESS-dən gəlir, məs. aicall.arzoomavto.az. Servislər hostun 3001/4000/8090 portlarındadır;
# ufw yalnız Docker şəbəkəsindən (172.16.0.0/12) bu portlara icazə verməlidir.
{$AICALL_ADDRESS:aicall.localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
	}

	request_body {
		max_size 50MB
	}

	# Telefon (Asterisk idarəsi) API-si və canlı monitor: telephony servisi.
	@telephony path_regexp telephony ^/api/(telephony|sip-accounts|trunks|ivr|dialplan)/
	handle @telephony {
		reverse_proxy host.docker.internal:8090
	}
	handle /ws/live-monitor* {
		reverse_proxy host.docker.internal:8090
	}
	# Gemini və monitor WebSocket-ləri: callbot backend.
	handle /ws/* {
		reverse_proxy host.docker.internal:4000
	}
	# Qalan hər şey (panel və onun /api/* proxy-ləri): Next.js frontend.
	handle {
		reverse_proxy host.docker.internal:3001
	}
}
